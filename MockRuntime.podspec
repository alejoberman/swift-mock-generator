Pod::Spec.new do |s|
  s.name             = 'MockRuntime'
  s.version          = '0.1.0'
  s.summary          = 'Runtime support for mocks generated by SwiftMockGenerator.'
  s.description      = 'Provides argument matching, stubbing, invocation recording, and verification for SwiftMockGenerator.'
  s.homepage         = 'https://github.com/REPLACE_WITH_YOUR_ORG/SwiftMockGenerator'
  s.license          = { :type => 'MIT', :file => 'LICENSE' }
  s.author           = { 'SwiftMockGenerator maintainers' => 'alejoberman@gmail.com' }
  # Repository URL.
  s.source           = { :git => 'git@github.com:alejoberman/swift-mock-generator.git', :tag => s.version.to_s }
  s.swift_version    = '6.0'
  s.ios.deployment_target = '15.0'
  s.osx.deployment_target = '11.0'
  s.source_files     = 'Sources/MockRuntime/**/*.swift'
  s.module_name      = 'MockRuntime'
  s.resources        = 'Scripts/**/*.{sh,json,xcprivacy}'
  s.requires_arc     = true
end
